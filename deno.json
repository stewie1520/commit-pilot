{
  "tasks": {
    "start": "deno run --allow-env --allow-read --allow-write --allow-sys --allow-net --allow-run src/index.ts",
    "dev": "deno run --watch --allow-env --allow-read --allow-write --allow-sys --allow-net --allow-run src/index.ts",
    "test": "deno test --allow-env --allow-read",
    "clean": "rm -rf ./bin",
    "build": "deno compile --output ./bin/cpx --allow-env --allow-read --allow-write --allow-sys --allow-net --allow-run ./src/index.ts"
  },
  "fmt": {
    "options": {
      "lineWidth": 100,
      "indentWidth": 2,
      "singleQuote": true
    }
  },
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.16",
    "chalk": "npm:chalk@^5.4.1",
    "genkitx-ollama": "npm:genkitx-ollama@^1.6.0",
    "inquirer": "npm:inquirer@^12.5.2"
  }
}
